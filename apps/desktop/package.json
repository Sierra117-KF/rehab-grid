{
  "name": "@rehab-grid/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs",
    "dev": "next dev",
    "dev:fast": "next dev --turbopack",
    "build": "next build",
    "tauri:dev": "tauri dev",
    "tauri:dev:fast": "tauri dev --config src-tauri/tauri.dev-fast.conf.json",
    "tauri:dev:debug": "tauri dev --devtools",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "copy-assets": "node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@rehab-grid/core": "workspace:*",
    "@rehab-grid/ui": "workspace:*",
    "@rehab-grid/pages": "workspace:*",
    "@tauri-apps/api": "2.12.0",
    "lucide-react": "1.48.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-fs": "2.6.0",
    "@tauri-apps/plugin-shell": "2.4.0",
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@rehab-grid/config": "workspace:*",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.2",
    "@tailwindcss/postcss": "4.3.2",
    "eslint": "9.39.4"
  }
}
